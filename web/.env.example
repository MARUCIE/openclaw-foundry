# OpenClaw Foundry web app — environment variable template
#
# Copy to .env.local for local development; set in Cloudflare Pages env vars for prod.
# All NEXT_PUBLIC_* vars are baked into the static build at `next build` time.

# Worker API base URL — single source of truth (web/lib/api-base.ts).
# Preferred name. Override this in prod CF Pages env to point at a custom domain.
NEXT_PUBLIC_API_BASE=https://openclaw-foundry-api.maoyuan-wen-683.workers.dev

# Legacy alias — kept for back-compat with older .env files. Used as fallback in
# web/lib/api-base.ts when NEXT_PUBLIC_API_BASE is unset.
# NEXT_PUBLIC_API_URL=https://openclaw-foundry-api.maoyuan-wen-683.workers.dev
